
{%- liquid
  assign adv_id = section.settings.advanced_section_id | default: section.id
  assign adv_dom_id = adv_id | handleize
  assign adv_custom_class = section.settings.advanced_custom_class | strip
  assign header_menu = section.settings.menu
-%}

{% render 'section-advanced-styles' %}

<header
  id="advanced-section-{{ adv_dom_id }}"
  class="site-header advanced-section {{ adv_custom_class }}"
>
  <div class="header-container advanced-section__inner">
    <div class="header-brand">
      <a href="{{ routes.root_url }}" class="site-logo">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: section.settings.logo_width
            | image_tag: alt: shop.name, class: 'header-logo-image'
          }}
        {% else %}
          {{ section.settings.logo_text | default: shop.name | escape }}
        {% endif %}
      </a>
    </div>
    <nav class="main-nav" aria-label="Main navigation">
      {% if header_menu != blank %}
        {% for link in header_menu.links %}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="/pages/about">About</a>
        <a href="/pages/contact">Contact</a>
      {% endif %}
    </nav>
    <a href="{{ routes.cart_url }}" class="cart-link">
      {{ section.settings.cart_text | escape }}
      <span>({{ cart.item_count }})</span>
    </a>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Store name",
      "info": "Used when no logo image is selected."
    },
    {
      "type": "header",
      "content": "Navigation Settings"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Cart Settings"
    },
    {
      "type": "text",
      "id": "cart_text",
      "label": "Cart text",
      "default": "Cart"
    },
    {
      "type": "header",
      "content": "Advanced Settings — Layout"
    },
    {
      "type": "select",
      "id": "advanced_width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "advanced_max_width",
      "label": "Maximum content width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "advanced_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing — Margin"
    },
    {
      "type": "range",
      "id": "advanced_margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_left",
      "label": "Margin left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_right",
      "label": "Margin right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing — Padding"
    },
    {
      "type": "range",
      "id": "advanced_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "advanced_background",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "advanced_background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Border and Shadow"
    },
    {
      "type": "select",
      "id": "advanced_border_style",
      "label": "Border style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
