      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "advanced_border_color",
      "label": "Border color",
      "default": "#DDDDDD"
    },
    {
      "type": "range",
      "id": "advanced_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "advanced_shadow",
      "label": "Box shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Responsive Visibility"
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "text",
      "id": "advanced_section_id",
      "label": "Custom section ID",
      "info": "Leave blank to use the automatic section ID."
    },
    {
      "type": "text",
      "id": "advanced_custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "textarea",
      "id": "advanced_custom_css",
      "label": "Custom CSS",
      "info": "Enter CSS declarations without style tags."
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}