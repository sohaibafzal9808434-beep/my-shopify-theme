<section class=" from-slate-900 via-blue-950 to-blue-700 px-6 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <span class="inline-block rounded-full border border-blue-300/40 bg-blue-400/10 px-4 py-2 text-sm font-medium text-blue-200">
        Welcome to Nexus
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl">
        Discover Your
        <span class="text-blue-300">Perfect Style</span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-7 text-slate-300 md:text-lg">
        Explore our latest collection of quality products, timeless designs,
        and everyday essentials made for you.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="{{ routes.all_products_collection_url }}"
          class="rounded-lg bg-white px-6 py-3 font-semibold text-slate-900 transition hover:bg-blue-100"
        >
          Shop Collection
        </a>

        <a
          href="/pages/about"
          class="rounded-lg border border-white/40 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
        >
          Discover Nexus
        </a>
      </div>
    </div>
  </div>
</section>

