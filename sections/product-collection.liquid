{%- liquid
  assign adv_id = section.settings.advanced_section_id | default: section.id
  assign adv_dom_id = adv_id | handleize
  assign adv_custom_class = section.settings.advanced_custom_class | strip
  assign selected_collection = section.settings.collection
  assign products_limit = section.settings.products_to_show
-%}

{% render 'section-advanced-styles' %}

<section
  id="advanced-section-{{ adv_dom_id }}"
  class="advanced-section product-collection {{ adv_custom_class }}"
>
  <div class="product-collection__container mx-auto">

    {% if section.settings.heading != blank %}
      <div class="product-collection__header">
        <div>
          <h2 class="product-collection__heading">
            {{ section.settings.heading | escape }}
          </h2>

          {% if section.settings.show_description %}
            {% if section.settings.description != blank %}
              <div class="product-collection__description">
                {{ section.settings.description }}
              </div>
            {% elsif selected_collection != blank %}
              <div class="product-collection__description">
                {{ selected_collection.description }}
              </div>
            {% endif %}
          {% endif %}
        </div>

        {% if section.settings.show_view_all and selected_collection != blank %}
          <a class="product-collection__view-all" href="{{ selected_collection.url }}">
            {{ section.settings.view_all_text | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      <div class="product-collection__grid">
        {% for product in selected_collection.products limit: products_limit %}
          {%- assign card_variant = product.selected_or_first_available_variant -%}

          <article class="product-card">
            <div class="product-card__media">
              <a href="{{ product.url }}" class="product-card__image-link">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 540, 720, 900',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                      alt: product.featured_image.alt,
                      class: 'product-card__image product-card__image--primary'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
                {% endif %}

                {% if section.settings.show_hover_image and product.images.size > 1 %}
                  {{
                    product.images[1]
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 540, 720, 900',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                      alt: product.title,
                      class: 'product-card__image product-card__image--hover'
                  }}
                {% endif %}
              </a>

              {% if section.settings.show_badges %}
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__badge">
                    {{ section.settings.sale_badge_text | escape }}
                  </span>
                {% elsif product.available == false %}
                  <span class="product-card__badge product-card__badge--sold-out">
                    {{ section.settings.sold_out_text | escape }}
                  </span>
                {% endif %}
              {% endif %}
            </div>

            <div class="product-card__details">
              {% if section.settings.show_vendor %}
                <p class="product-card__vendor">{{ product.vendor | escape }}</p>
              {% endif %}

              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>

              {% if section.settings.show_price %}
                <div class="product-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="product-card__sale-price">{{ product.price | money }}</span>
                    <s>{{ product.compare_at_price | money }}</s>
                  {% else %}
                    <span>{{ product.price | money }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if section.settings.show_add_to_cart %}
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    {% form 'product', product, class: 'product-card__product-form' %}
                      <input type="hidden" name="id" value="{{ card_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" name="add" class="product-card__add-button">
                        {{ section.settings.add_to_cart_text | escape }}
                      </button>
                    {% endform %}
                  {% else %}
                    <a href="{{ product.url }}" class="product-card__add-button">
                      {{ section.settings.choose_options_text | escape }}
                    </a>
                  {% endif %}
                {% else %}
                  <button type="button" class="product-card__add-button" disabled>
                    {{ section.settings.sold_out_text | escape }}
                  </button>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-collection__empty">
        <p>{{ section.settings.empty_message | escape }}</p>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #advanced-section-{{ adv_dom_id }} {
    box-sizing: border-box;
    background: {{ section.settings.section_background }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__container {
    width: 100%;
    max-width: {% if section.settings.advanced_width == 'boxed' %}{{ section.settings.advanced_max_width }}px{% else %}1600px{% endif %};
    margin-inline: auto;
    padding-inline: 24px;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__description {
    margin-top: 12px;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__view-all {
    display: inline-block;
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_background }};
    border-radius: {{ section.settings.button_radius }}px;
    padding: 10px 18px;
    text-decoration: none;
    white-space: nowrap;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  #advanced-section-{{ adv_dom_id }} .product-card {
    min-width: 0;
    overflow: hidden;
    background: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__media {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.image_background }};
    aspect-ratio: {% if section.settings.image_ratio == 'portrait' %}3 / 4{% elsif section.settings.image_ratio == 'landscape' %}4 / 3{% else %}1 / 1{% endif %};
  }

  #advanced-section-{{ adv_dom_id }} .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__image,
  #advanced-section-{{ adv_dom_id }} .product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform .3s ease, opacity .3s ease;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  {% if section.settings.show_hover_image %}
    #advanced-section-{{ adv_dom_id }} .product-card__media:hover .product-card__image--hover {
      opacity: 1;
    }

    #advanced-section-{{ adv_dom_id }} .product-card__media:hover .product-card__image--primary {
      opacity: 0;
    }
  {% endif %}

  {% if section.settings.image_hover_zoom %}
    #advanced-section-{{ adv_dom_id }} .product-card__media:hover .product-card__image {
      transform: scale(1.05);
    }
  {% endif %}

  #advanced-section-{{ adv_dom_id }} .product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 5px 9px;
    border-radius: 4px;
    color: {{ section.settings.badge_text_color }};
    background: {{ section.settings.badge_background }};
    font-size: 12px;
    font-weight: 600;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__badge--sold-out {
    background: #475569;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__details {
    padding: {{ section.settings.card_padding }}px;
    text-align: {{ section.settings.card_text_alignment }};
  }

  #advanced-section-{{ adv_dom_id }} .product-card__vendor {
    margin: 0 0 6px;
    color: {{ section.settings.vendor_color }};
    font-size: 12px;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__title {
    margin: 0 0 10px;
    font-size: {{ section.settings.product_title_size }}px;
    line-height: 1.4;
    font-weight: 600;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__title a {
    color: {{ section.settings.heading_color }};
    text-decoration: none;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {% if section.settings.card_text_alignment == 'center' %}center{% elsif section.settings.card_text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap: 8px;
    margin-bottom: 14px;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__sale-price {
    color: {{ section.settings.sale_price_color }};
    font-weight: 700;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__product-form {
    margin: 0;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__add-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 11px 14px;
    border: 1px solid {{ section.settings.button_background }};
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  #advanced-section-{{ adv_dom_id }} .product-card__add-button:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  #advanced-section-{{ adv_dom_id }} .product-collection__empty {
    padding: 32px;
    text-align: center;
    border: 1px dashed {{ section.settings.card_border_color }};
  }

  {% if section.settings.advanced_alignment == 'center' %}
    #advanced-section-{{ adv_dom_id }} .product-collection__header {
      text-align: center;
    }
  {% elsif section.settings.advanced_alignment == 'right' %}
    #advanced-section-{{ adv_dom_id }} .product-collection__header {
      text-align: right;
    }
  {% endif %}

  {% if section.settings.advanced_hide_desktop %}
    @media screen and (min-width: 990px) {
      #advanced-section-{{ adv_dom_id }} { display: none !important; }
    }
  {% endif %}

  {% if section.settings.advanced_hide_tablet %}
    @media screen and (min-width: 750px) and (max-width: 989px) {
      #advanced-section-{{ adv_dom_id }} { display: none !important; }
    }
  {% endif %}

  {% if section.settings.advanced_hide_mobile %}
    @media screen and (max-width: 749px) {
      #advanced-section-{{ adv_dom_id }} { display: none !important; }
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    #advanced-section-{{ adv_dom_id }} .product-collection__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #advanced-section-{{ adv_dom_id }} .product-collection__container {
      padding-inline: 16px;
    }

    #advanced-section-{{ adv_dom_id }} .product-collection__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Custom description",
      "default": "<p>Explore our latest products.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All text",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" },
        { "value": "5", "label": "5 columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Product gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "image_hover_zoom",
      "label": "Zoom image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show sale/sold-out badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show product button",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "choose_options_text",
      "label": "Variant button text",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold-out text",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty collection message",
      "default": "Choose a collection with products to display here."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading/product title color",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#0F172A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "advanced_width",
      "label": "Advanced section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "full"
    },
    {
      "type": "text",
      "id": "advanced_section_id",
      "label": "Custom section ID"
    },
    {
      "type": "text",
      "id": "advanced_custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "textarea",
      "id": "advanced_custom_css",
      "label": "Custom CSS",
      "info": "Enter CSS declarations without style tags."
    }
  ],
  "presets": [
    {
      "name": "Product Collection"
    }
  ]
}
{% endschema %}