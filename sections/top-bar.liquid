
{%- liquid
  assign adv_id = section.settings.advanced_section_id | default: section.id
  assign adv_dom_id = adv_id | handleize
  assign adv_custom_class = section.settings.advanced_custom_class | strip
-%}

{% render 'section-advanced-styles' %}

<section
  id="advanced-section-{{ adv_dom_id }}"
  class="advanced-section bg-slate-900 px-4 py-3 text-white{% if adv_custom_class != blank %} {{ adv_custom_class | escape }}{% endif %}"
>
  <div class="advanced-section__inner mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 md:flex-row">

    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs sm:text-sm">

      {% if section.settings.show_email and section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email | escape }}"
           class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'mail', size: 16 %}
          <span>{{ section.settings.email | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_phone and section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone | remove: ' ' | escape }}"
           class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'phone', size: 16 %}
          <span>{{ section.settings.phone | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_location and section.settings.location != blank %}
        {% if section.settings.location_url != blank %}
          <a href="{{ section.settings.location_url }}"
             class="inline-flex items-center gap-2 transition hover:text-gray-300">
        {% else %}
          <span class="inline-flex items-center gap-2">
        {% endif %}

          {% render 'icon', name: 'map-pin', size: 16 %}
          <span>{{ section.settings.location | escape }}</span>

        {% if section.settings.location_url != blank %}
          </a>
        {% else %}
          </span>
        {% endif %}
      {% endif %}

    </div>

    <div class="flex items-center gap-4">

      {% if section.settings.show_facebook and section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition hover:text-blue-300">
          {% render 'icon', name: 'facebook', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_tiktok and section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="transition hover:text-blue-300">
          {% render 'icon', name: 'tiktok', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_instagram and section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition hover:text-gray-300">
          {% render 'icon', name: 'instagram', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_youtube and section.settings.youtube_url != blank %}
        <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="transition hover:text-blue-300">
          {% render 'icon', name: 'youtube', size: 20 %}
        </a>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top contact bar",
  "settings": [
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@example.com"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+92 300 1234567"
    },
    {
      "type": "checkbox",
      "id": "show_location",
      "label": "Show location",
      "default": true
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location text",
      "default": "Pakistan"
    },
    {
      "type": "url",
      "id": "location_url",
      "label": "Location link",
      "info": "Optional Google Maps link"
    },
    {
      "type": "header",
      "content": "Social media links"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "Show YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube channel URL"
    },
    {
      "type": "header",
      "content": "Advanced Settings"
    },
    {
      "type": "select",
      "id": "advanced_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "advanced_max_width",
      "label": "Maximum content width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "advanced_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "advanced_margin_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_left",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_margin_right",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "advanced_padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_left",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "advanced_padding_right",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "advanced_background",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "advanced_background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Border and shadow"
    },
    {
      "type": "select",
      "id": "advanced_border_style",
      "label": "Border style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "advanced_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "advanced_border_color",
      "label": "Border color",
      "default": "#DDDDDD"
    },
    {
      "type": "range",
      "id": "advanced_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "advanced_shadow",
      "label": "Shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Responsive visibility"
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "advanced_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "advanced_z_index",
      "label": "Z-index",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "advanced_section_id",
      "label": "Custom section ID"
    },
    {
      "type": "text",
      "id": "advanced_custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "textarea",
      "id": "advanced_custom_css",
      "label": "Custom CSS declarations",
      "info": "CSS declarations only, without selectors or curly braces."
    }
  ],
  "presets": [
    {
      "name": "Top contact bar"
    }
  ]
}
{% endschema %}
