
<div class="bg-slate-900 px-4 py-3 text-white">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 md:flex-row">
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs sm:text-sm">
      {% if section.settings.show_email and section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email | escape }}" class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'mail', size: 16 %}
          <span>{{ section.settings.email | escape }}</span>
        </a>
      {% endif %}
      {% if section.settings.show_phone and section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone | remove: ' ' | escape }}" class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'phone', size: 16 %}
          {% render 'icon', name: 'heart', size: 19 %}
          <span>{{ section.settings.phone | escape }}</span>
        </a>
      {% endif %}
      {% if section.settings.show_location and section.settings.location != blank %}
        {% if section.settings.location_url != blank %}
          <a href="{{ section.settings.location_url }}" class="inline-flex items-center gap-2 transition hover:text-gray-300">
        {% else %}
          <span class="inline-flex items-center gap-2">
        {% endif %}
          {% render 'icon', name: 'map-pin', size: 16 %}
          <span>{{ section.settings.location | escape }}</span>
        {% if section.settings.location_url != blank %}</a>{% else %}</span>{% endif %}
      {% endif %}
    </div>
    <div class="flex items-center gap-4">
      {% if section.settings.show_facebook and section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition hover:text-blue-300">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.1H7v3.2h2.8V21z"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_tiktok and section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="transition hover:text-blue-300">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19.6 7.1a6.7 6.7 0 0 1-4.1-1.4v8.1a6 6 0 1 1-6-6c.4 0 .8 0 1.2.1v3.3a2.8 2.8 0 1 0 1.8 2.6V2h3.1a6.7 6.7 0 0 0 4 4z"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_instagram and section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition hover:text-gray-300">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_youtube and section.settings.youtube_url != blank %}
        <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="transition hover:text-blue-300">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6z"/></svg>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Top contact bar",
  "settings": [
    {"type":"header","content":"Contact information"},
    {"type":"checkbox","id":"show_email","label":"Show email","default":true},
    {"type":"text","id":"email","label":"Email address","default":"info@example.com"},
    {"type":"checkbox","id":"show_phone","label":"Show phone","default":true},
    {"type":"text","id":"phone","label":"Phone number","default":"+92 300 1234567"},
    {"type":"checkbox","id":"show_location","label":"Show location","default":true},
    {"type":"text","id":"location","label":"Location text","default":"Pakistan"},
    {"type":"url","id":"location_url","label":"Location link","info":"Optional Google Maps link"},
    {"type":"header","content":"Social media links"},
    {"type":"checkbox","id":"show_facebook","label":"Show Facebook","default":true},
    {"type":"url","id":"facebook_url","label":"Facebook profile URL"},
    {"type":"checkbox","id":"show_tiktok","label":"Show TikTok","default":true},
    {"type":"url","id":"tiktok_url","label":"TikTok profile URL"},
    {"type":"checkbox","id":"show_instagram","label":"Show Instagram","default":true},
    {"type":"url","id":"instagram_url","label":"Instagram profile URL"},
    {"type":"checkbox","id":"show_youtube","label":"Show YouTube","default":true},
    {"type":"url","id":"youtube_url","label":"YouTube channel URL"}
  ],
  "presets": [{"name":"Top contact bar"}]
}
{% endschema %}

