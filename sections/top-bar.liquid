
<div class="bg-slate-900 px-4 py-3 text-white">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 md:flex-row">

    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs sm:text-sm">

      {% if section.settings.show_email and section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email | escape }}"
           class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'mail', size: 16 %}
          <span>{{ section.settings.email | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_phone and section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone | remove: ' ' | escape }}"
           class="inline-flex items-center gap-2 transition hover:text-blue-300">
          {% render 'icon', name: 'phone', size: 16 %}
          {% render 'icon' , name: 'mail', size: 16 %}
          <span>{{ section.settings.phone | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_location and section.settings.location != blank %}
        {% if section.settings.location_url != blank %}
          <a href="{{ section.settings.location_url }}"
             class="inline-flex items-center gap-2 transition hover:text-gray-300">
        {% else %}
          <span class="inline-flex items-center gap-2">
        {% endif %}

          {% render 'icon', name: 'map-pin', size: 16 %}
          <span>{{ section.settings.location | escape }}</span>

        {% if section.settings.location_url != blank %}
          </a>
        {% else %}
          </span>
        {% endif %}
      {% endif %}

    </div>

    <div class="flex items-center gap-4">

      {% if section.settings.show_facebook and section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Facebook"
           class="transition hover:text-blue-300">
          {% render 'icon', name: 'facebook', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_tiktok and section.settings.tiktok_url != blank %}
        <a href="{{ section.settings.tiktok_url }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="TikTok"
           class="transition hover:text-blue-300">
          {% render 'icon', name: 'tiktok', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_instagram and section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Instagram"
           class="transition hover:text-gray-300">
          {% render 'icon', name: 'instagram', size: 18 %}
        </a>
      {% endif %}

      {% if section.settings.show_youtube and section.settings.youtube_url != blank %}
        <a href="{{ section.settings.youtube_url }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="YouTube"
           class="transition hover:text-blue-300">
          {% render 'icon', name: 'youtube', size: 20 %}
        </a>
      {% endif %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Top contact bar",
  "settings": [
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@example.com"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+92 300 1234567"
    },
    {
      "type": "checkbox",
      "id": "show_location",
      "label": "Show location",
      "default": true
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location text",
      "default": "Pakistan"
    },
    {
      "type": "url",
      "id": "location_url",
      "label": "Location link",
      "info": "Optional Google Maps link"
    },
    {
      "type": "header",
      "content": "Social media links"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "Show YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube channel URL"
    },
    {
  "type": "header",
  "content": "Advanced Settings"
},
{
  "type": "range",
  "id": "advanced_padding_top",
  "label": "Padding top",
  "min": 0,
  "max": 100,
  "step": 4,
  "unit": "px",
  "default": 0
}
  ],
  "presets": [
    {
      "name": "Top contact bar"
    }
  ]
}
{% endschema %}
