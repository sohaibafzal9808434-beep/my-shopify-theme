
{%- comment -%}
  Usage:
  {% render 'icon', name: 'search' %}
  {% render 'icon', name: 'cart' %}
  {% render 'icon', name: 'user' %}
  {% render 'icon', name: 'menu' %}
{%- endcomment -%}

{%- assign icon_size = size | default: 24 -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="{{ class }}"
  aria-hidden="true"
>
  {%- case name -%}

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>

    {%- when 'cart' -%}
      <circle cx="9" cy="21" r="1"/>
      <circle cx="20" cy="21" r="1"/>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>

    {%- when 'user' -%}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>

    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"/>

    {%- when 'close' -%}
      <path d="m18 6-12 12M6 6l12 12"/>

    {%- when 'heart' -%}
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/>

    {%- when 'arrow-right' -%}
      <path d="M5 12h14M12 5l7 7-7 7"/>

    {%- when 'check' -%}
      <path d="m5 12 4 4L19 6"/>

    {%- when 'phone' -%}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.1 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.72 2.04Z"/>

    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="m3 7 9 6 9-6"/>

    {%- when 'truck' -%}
      <path d="M10 17h4V5H2v12h3"/>
      <path d="M14 9h5l3 4v4h-3"/>
      <circle cx="7.5" cy="17.5" r="2.5"/>
      <circle cx="16.5" cy="17.5" r="2.5"/>

    {%- when 'trash' -%}
      <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/>

    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>

    {%- when 'minus' -%}
      <path d="M5 12h14"/>

    {%- when 'star' -%}
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/>

    {%- when 'map-pin' -%}
      <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
      <circle cx="12" cy="10" r="2.5"/>

  {%- endcase -%}
</svg>
